# Source lists and per-library flags for the static Makefile build of the
# parallel_gamecubewii libretro core. Included by Makefile, which sets the
# platform switches used here:
#
#   ARCH_X86_64 / ARCH_ARM64                 target architecture
#   OS_WIN / OS_ANDROID / OS_UNIX            OS family (OS_UNIX: Linux, webOS)
#   OS_APPLE, with OS_MACOS or OS_IOS        Apple (OS_IOS covers iOS and tvOS)
#   HAVE_LIBUSB HAVE_HIDAPI HAVE_CPPIPC      optional components
#   HAVE_VULKAN HAVE_D3D
#   HAVE_BUNDLED_ICONV                       Externals/libiconv instead of libc
#
# Units only the standalone frontends use are left out.

EXT_DIR := $(CORE_DIR)/Externals
SRC_DIR := $(CORE_DIR)/Source/Core

# ----------------------------------------------------------------------------
# Generated files
# ----------------------------------------------------------------------------
# Plain substitutions of the upstream templates. The
# per-platform configure results (curl_config.h, the libusb, libiconv and
# libcharset config.h, mGBA's flags.h) are checked in under
# Externals/<library>/makefile instead.
ZLIBNG_DIR      := $(EXT_DIR)/zlib-ng/zlib-ng
ZLIBNG_GEN_DIR  := $(GEN_DIR)/Externals/zlib-ng/zlib-ng
SCMREV_H        := $(GEN_DIR)/Source/Core/Common/scmrev.h
MGBA_VERSION_C  := $(GEN_DIR)/Externals/mGBA/mgba/version.c

GEN_HEADERS := \
	$(SCMREV_H) \
	$(ZLIBNG_GEN_DIR)/zlib.h \
	$(ZLIBNG_GEN_DIR)/zconf.h \
	$(ZLIBNG_GEN_DIR)/zlib_name_mangling.h

$(ZLIBNG_GEN_DIR)/zlib.h: $(ZLIBNG_DIR)/zlib.h.in
	@mkdir -p $(@D)
	sed 's/@ZLIB_SYMBOL_PREFIX@//g' $< > $@

$(ZLIBNG_GEN_DIR)/gzread.c: $(ZLIBNG_DIR)/gzread.c.in
	@mkdir -p $(@D)
	sed 's/@ZLIB_SYMBOL_PREFIX@//g' $< > $@

$(ZLIBNG_GEN_DIR)/zconf.h: $(ZLIBNG_DIR)/zconf.h.in
	@mkdir -p $(@D)
	sed 's|^#ifdef HAVE_UNISTD_H .*$$|#if 1    /* was set to #if 1 by configure/cmake/etc */|' $< > $@

$(ZLIBNG_GEN_DIR)/zlib_name_mangling.h: $(ZLIBNG_DIR)/zlib_name_mangling.h.empty
	@mkdir -p $(@D)
	cp $< $@

# scmrev.h and mGBA's version.c carry the revision the tree is at, so they
# are rewritten at parse time, but only touched when their content changes.
HASH := \#

SCM_REV    := $(shell git -C $(CORE_DIR) rev-parse HEAD 2>/dev/null)
SCM_DESC   := $(shell git -C $(CORE_DIR) describe --always --long --dirty 2>/dev/null | sed -E 's/(-0)?-[^-]+((-dirty)?)$$/\2/')
SCM_BRANCH := $(shell git -C $(CORE_DIR) rev-parse --abbrev-ref HEAD 2>/dev/null)
SCM_AHEAD  := $(shell git -C $(CORE_DIR) rev-list --count HEAD ^master 2>/dev/null)
ifeq ($(SCM_REV),)
   SCM_REV    := 2609.0 (no further info)
   SCM_DESC   := 2609.0
   SCM_BRANCH := master
endif
ifeq ($(SCM_AHEAD),)
   SCM_AHEAD := 0
endif

SCMREV_STATUS := $(shell \
	mkdir -p $(dir $(SCMREV_H)); \
	printf '%s\n' \
		'$(HASH)define SCM_REV_STR "$(SCM_REV)"' \
		'$(HASH)define SCM_DESC_STR "$(SCM_DESC)"' \
		'$(HASH)define SCM_BRANCH_STR "$(SCM_BRANCH)"' \
		'$(HASH)define SCM_COMMITS_AHEAD_MASTER $(SCM_AHEAD)' \
		'$(HASH)define SCM_DISTRIBUTOR_STR "None"' > $(SCMREV_H).tmp; \
	cmp -s $(SCMREV_H).tmp $(SCMREV_H) || mv -f $(SCMREV_H).tmp $(SCMREV_H); \
	rm -f $(SCMREV_H).tmp)

MGBA_GIT    := git -C $(EXT_DIR)/mGBA/mgba
MGBA_COMMIT := $(shell $(MGBA_GIT) describe --always --abbrev=40 --dirty 2>/dev/null || echo "(unknown)")
MGBA_SHORT  := $(shell $(MGBA_GIT) describe --always --dirty 2>/dev/null || echo "(unknown)")
MGBA_REV    := $(shell $(MGBA_GIT) rev-list HEAD --count 2>/dev/null || echo -1)

MGBA_VERSION_STATUS := $(shell \
	mkdir -p $(dir $(MGBA_VERSION_C)); \
	printf '%s\n' \
		'$(HASH)include <mgba/core/version.h>' \
		'MGBA_EXPORT const char* const gitCommit = "$(MGBA_COMMIT)";' \
		'MGBA_EXPORT const char* const gitCommitShort = "$(MGBA_SHORT)";' \
		'MGBA_EXPORT const char* const gitBranch = "(unknown)";' \
		'MGBA_EXPORT const int gitRevision = $(MGBA_REV);' \
		'MGBA_EXPORT const char* const binaryName = "mgba";' \
		'MGBA_EXPORT const char* const projectName = "mGBA";' \
		'MGBA_EXPORT const char* const projectVersion = "0.11.0";' > $(MGBA_VERSION_C).tmp; \
	cmp -s $(MGBA_VERSION_C).tmp $(MGBA_VERSION_C) || mv -f $(MGBA_VERSION_C).tmp $(MGBA_VERSION_C); \
	rm -f $(MGBA_VERSION_C).tmp)

# ----------------------------------------------------------------------------
# Include sets shared by several libraries
# ----------------------------------------------------------------------------
ZLIB_INC  := -I$(ZLIBNG_GEN_DIR) -I$(ZLIBNG_DIR)
ZSTD_INC  := -I$(EXT_DIR)/zstd/zstd/lib
LZMA_INC  := -I$(EXT_DIR)/liblzma/api
MGBA_INC  := -I$(EXT_DIR)/mGBA/mgba/include -I$(EXT_DIR)/mGBA/makefile
ICONV_INC :=
ifeq ($(HAVE_BUNDLED_ICONV),1)
   ICONV_INC := \
	-I$(EXT_DIR)/libiconv/include \
	-I$(EXT_DIR)/libiconv/makefile/lib \
	-I$(EXT_DIR)/libiconv/libcharset/include \
	-I$(EXT_DIR)/libiconv/makefile/libcharset
endif

