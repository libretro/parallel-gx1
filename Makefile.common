	$(CORE_DIR)/Externals/cpp-ipc/cpp-ipc/src/libipc/mem/new.cpp \
	$(CORE_DIR)/Externals/cpp-ipc/cpp-ipc/src/libipc/mem/new_delete_resource.cpp

# ADRENOTOOLS
ADRENOTOOLS_SOURCES_C :=
ADRENOTOOLS_SOURCES_CXX :=
ADRENOTOOLS_SOURCES_ASM :=
ADRENOTOOLS_SOURCES_OBJCXX :=
ifeq ($(OS_ANDROID),1)
   ifeq ($(ARCH_ARM64),1)
      ADRENOTOOLS_SOURCES_CXX += \
	$(CORE_DIR)/Externals/libadrenotools/lib/linkernsbypass/android_linker_ns.cpp \
	$(CORE_DIR)/Externals/libadrenotools/lib/linkernsbypass/elf_soname_patcher.cpp \
	$(CORE_DIR)/Externals/libadrenotools/src/bcenabler.cpp \
	$(CORE_DIR)/Externals/libadrenotools/src/driver.cpp
   endif
endif

# ----------------------------------------------------------------------------
# Per-library flags
# ----------------------------------------------------------------------------
# <LIB>_FLAGS applies to every object of that library, <LIB>_CFLAGS and
# <LIB>_CXXFLAGS to its C and C++ objects only. Third-party code builds
# with warnings off.

BDISASM_FLAGS := -w -I$(EXT_DIR)/Bochs_disasm

FATFS_FLAGS := -w -I$(EXT_DIR)/FatFs

# RSLC_EXTENDED: rslc takes the stages and types the core's shaders use.
LIBRETRO_COMMON_FLAGS := -DHAVE_THREADS -DHAVE_THREAD_STORAGE -DRSLC_EXTENDED \
	-I$(EXT_DIR)/libretro-common/include


LZO_FLAGS := -w -I$(EXT_DIR)/LZO

SFML_FLAGS    := -w -DSFML_STATIC -I$(EXT_DIR)/SFML/SFML/include -I$(EXT_DIR)/SFML/SFML/src
SFML_CXXFLAGS := -std=gnu++20

BZIP2_FLAGS := -w -DHAVE_UNISTD_H -D_LARGEFILE64_SOURCE=1 -I$(EXT_DIR)/bzip2/bzip2

CURL_FLAGS := -w -DBUILDING_LIBCURL -DCURL_HIDDEN_SYMBOLS -DHAVE_CONFIG_H \
	-I$(EXT_DIR)/curl/curl/include -I$(EXT_DIR)/curl/makefile
ifeq ($(OS_WIN),1)
   CURL_FLAGS += -DCURL_STATICLIB
else
   CURL_FLAGS += -I$(EXT_DIR)/mbedtls/include
endif
ifeq ($(OS_UNIX),1)
   CURL_FLAGS += -D_GNU_SOURCE
endif

MBEDTLS_FLAGS := -w -O2 -I$(EXT_DIR)/mbedtls/include -I$(EXT_DIR)/mbedtls/library

FMT_FLAGS := -w -I$(EXT_DIR)/fmt/fmt/include

HIDAPI_FLAGS := -w -I$(EXT_DIR)/hidapi/hidapi-src/hidapi
ifeq ($(OS_UNIX),1)
   HIDAPI_FLAGS += -isystem $(EXT_DIR)/libusb/libusb/libusb
endif
# The core exports the libretro API only; hidapi would dllexport its own.
ifeq ($(OS_WIN),1)
   HIDAPI_FLAGS += -DHID_API_NO_EXPORT_DEFINE
endif

LIBUSB_FLAGS := -w -I$(EXT_DIR)/libusb/makefile -I$(EXT_DIR)/libusb/libusb/libusb

LIBCHARSET_FLAGS := -w -D_ALL_SOURCE -D_DARWIN_C_SOURCE -D_GNU_SOURCE \
	-D_HPUX_ALT_XOPEN_SOCKET_API -D_MINIX -D_NETBSD_SOURCE -D_OPENBSD_SOURCE \
	-D_POSIX_1_SOURCE -D_POSIX_PTHREAD_SEMANTICS -D_POSIX_SOURCE -D_TANDEM_SOURCE \
	-D_XOPEN_SOURCE -D__EXTENSIONS__ -D__STDC_WANT_IEC_60559_ATTRIBS_EXT__ \
	-D__STDC_WANT_IEC_60559_BFP_EXT__ -D__STDC_WANT_IEC_60559_DFP_EXT__ \
	-D__STDC_WANT_IEC_60559_EXT__ -D__STDC_WANT_IEC_60559_FUNCS_EXT__ \
	-D__STDC_WANT_IEC_60559_TYPES_EXT__ -D__STDC_WANT_LIB_EXT2__ \
	-D__STDC_WANT_MATH_SPEC_FUNCS__ \
	-I$(EXT_DIR)/libiconv/libcharset/include -I$(EXT_DIR)/libiconv/makefile/libcharset

ICONV_FLAGS := -w \
	-I$(EXT_DIR)/libiconv/include -I$(EXT_DIR)/libiconv/makefile/lib \
	-I$(EXT_DIR)/libiconv/libcharset/include -I$(EXT_DIR)/libiconv/makefile/libcharset

LZMA_FLAGS := -w -DHAVE_CONFIG_H -DHAVE_UNISTD_H -DLZMA_API_STATIC -D_LARGEFILE64_SOURCE=1 \
	$(LZMA_INC) -I$(EXT_DIR)/liblzma -I$(EXT_DIR)/liblzma/check \
	-I$(EXT_DIR)/liblzma/common -I$(EXT_DIR)/liblzma/delta -I$(EXT_DIR)/liblzma/lz \
	-I$(EXT_DIR)/liblzma/lzma -I$(EXT_DIR)/liblzma/rangecoder \
	-I$(EXT_DIR)/liblzma/simple -I$(EXT_DIR)/liblzma/tuklib
ifneq ($(OS_WIN),1)
   LZMA_FLAGS += -DHAVE_WCWIDTH=1
endif

SPNG_FLAGS  := -DSPNG_DISABLE_OPT=1 -DSPNG_STATIC -I$(EXT_DIR)/libspng/libspng/spng $(ZLIB_INC)
SPNG_CFLAGS := -std=gnu99

ZLIB_FLAGS  := -w -O2 -DHAVE_BUILTIN_CTZ -DHAVE_BUILTIN_CTZLL -DWITH_GZFILEOP -DZLIB_COMPAT \
	-D_LARGEFILE64_SOURCE=1 -D__USE_LARGEFILE64 $(ZLIB_INC)
ZLIB_CFLAGS := -std=c11
ifneq ($(OS_WIN),1)
   ZLIB_FLAGS += -DHAVE_POSIX_MEMALIGN -DHAVE_VISIBILITY_HIDDEN -DHAVE_VISIBILITY_INTERNAL
endif
ifneq (,$(filter 1,$(OS_UNIX) $(OS_ANDROID)))
   ZLIB_FLAGS += -DHAVE_SYS_AUXV_H
endif
ifeq ($(ARCH_X86_64),1)
   ZLIB_FLAGS += -DX86_FEATURES -DX86_MASK_INTRIN -DX86_SSE2 -DX86_SSE2_CHUNKSET \
	-DX86_SSE2_SLIDEHASH -DX86_SSSE3 -DX86_SSSE3_ADLER32 -DX86_SSE41 \
	-DX86_SSE42_ADLER32 -DX86_SSE42_CRC_HASH -DX86_SSE42_CRC_INTRIN \
	-DX86_PCLMULQDQ_CRC -DX86_AVX2 -DX86_AVX2_ADLER32 -DX86_AVX_CHUNKSET \
	-DX86_AVX512 -DX86_AVX512_ADLER32 -DX86_AVX512VNNI -DX86_AVX512VNNI_ADLER32
else ifeq ($(ARCH_ARM64),1)
   ZLIB_FLAGS += -DARM_FEATURES -DARM_ACLE_CRC_HASH -DARM_NEON -DARM_NEON_ADLER32 \
	-DARM_NEON_CHUNKSET -DARM_NEON_HASLD4 -DARM_NEON_SLIDEHASH
   ifeq ($(OS_UNIX),1)
      ZLIB_FLAGS += -DARM_AUXV_HAS_CRC32
   endif
endif

LZ4_FLAGS := -w -DXXH_NAMESPACE=LZ4_ -I$(EXT_DIR)/lz4/lz4/lib

MGBA_FLAGS := -w -DBUILD_STATIC -DDISABLE_THREADING -DENABLE_DIRECTORIES -DENABLE_VFS \
	-DENABLE_VFS_FD -DHAVE_CRC32 -DHAVE_SETLOCALE -DHAVE_STRDUP -DHAVE_VASPRINTF \
	-DM_CORE_GB -DM_CORE_GBA -DUSE_LZMA -D_7ZIP_PPMD_SUPPPORT \
	$(MGBA_INC) -I$(EXT_DIR)/mGBA/mgba/src -I$(EXT_DIR)/mGBA/mgba/src/third-party/lzma \
	$(ZLIB_INC) -fwrapv
MGBA_CFLAGS := -std=c11
ifneq ($(OS_WIN),1)
   MGBA_FLAGS += -DHAVE_FREELOCALE -DHAVE_FUTIMENS -DHAVE_LOCALE -DHAVE_LOCALTIME_R \
	-DHAVE_NEWLOCALE -DHAVE_PTHREAD_CREATE -DHAVE_PTHREAD_SETNAME_NP -DHAVE_REALPATH \
	-DHAVE_STRLCPY -DHAVE_STRNDUP -DHAVE_USELOCALE -DUSE_PTHREADS
endif
ifeq ($(OS_ANDROID),1)
   MGBA_FLAGS += -DHAVE_STRTOF_L -DHAVE_XLOCALE -Dfutimes=futimens
else
   MGBA_FLAGS += -D_GNU_SOURCE
endif
ifeq ($(OS_UNIX),1)
   MGBA_FLAGS += -DHAVE_FUTIMES -pthread
endif
ifeq ($(OS_APPLE),1)
   MGBA_FLAGS += -D_DARWIN_C_SOURCE -DHAVE_FUTIMES -DHAVE_XLOCALE -DHAVE_SNPRINTF_L -DHAVE_STRTOF_L
endif

MINIZIP_FLAGS := -w -DHAVE_INTTYPES_H -DHAVE_LZMA -DHAVE_STDINT_H -DHAVE_ZLIB -DHAVE_ZSTD \
	-DLZMA_API_STATIC -DMZ_ZIP_NO_CRYPTO -DMZ_ZIP_NO_ENCRYPTION -DZLIB_COMPAT \
	-D_LARGEFILE64_SOURCE -D__USE_LARGEFILE64 \
	$(ZLIB_INC) $(LZMA_INC) $(ZSTD_INC) $(ICONV_INC) -I$(EXT_DIR)/minizip-ng/minizip-ng
MINIZIP_CFLAGS := -std=gnu99
ifneq ($(OS_ANDROID),1)
   MINIZIP_FLAGS += -DZSTD_MULTITHREAD
endif
ifeq ($(OS_WIN),1)
   MINIZIP_FLAGS += -D_CRT_NONSTDC_NO_DEPRECATE -D_CRT_SECURE_NO_DEPRECATE
else
   MINIZIP_FLAGS += -DHAVE_ICONV -D_BSD_SOURCE -D_POSIX_C_SOURCE=200809L
endif

ZSTD_FLAGS := -w -DXXH_NAMESPACE=ZSTD_ -DZSTD_LEGACY_SUPPORT=5 $(ZSTD_INC)
ifeq ($(OS_ANDROID),1)
   ZSTD_FLAGS += -DLIBC_NO_FSEEKO
else
   ZSTD_FLAGS += -DZSTD_MULTITHREAD
endif
ifneq ($(ARCH_X86_64)$(OS_WIN),1)
   ZSTD_FLAGS += -DZSTD_DISABLE_ASM
endif

PUGIXML_FLAGS := -w -DPUGIXML_NO_EXCEPTIONS -I$(EXT_DIR)/pugixml/pugixml/src

TINYGLTF_FLAGS    := -w -DTINYGLTF_NOEXCEPTION -DTINYGLTF_NO_EXTERNAL_IMAGE -DTINYGLTF_USE_CPP14
TINYGLTF_CXXFLAGS := -std=gnu++20

XXHASH_FLAGS := -w -I$(EXT_DIR)/xxhash/xxHash

CPPIPC_FLAGS := -w -O2 -DUNICODE -D_UNICODE -fexceptions \
	-I$(EXT_DIR)/cpp-ipc/cpp-ipc/include -I$(EXT_DIR)/cpp-ipc/cpp-ipc/src \
	-I$(EXT_DIR)/cpp-ipc/cpp-ipc/src/libipc/platform/linux
CPPIPC_CXXFLAGS := -std=gnu++17

ADRENOTOOLS_FLAGS := -w -I$(EXT_DIR)/libadrenotools/include -I$(EXT_DIR)/libadrenotools \
	-I$(EXT_DIR)/libadrenotools/lib/linkernsbypass

# Dolphin itself: every Source/ unit shares one set.
DOLPHIN_FLAGS := \
	-DENABLE_DIRECTORIES -DHAVE_THREAD_STORAGE -DENABLE_VFS -DHAS_LIBMGBA -DHAVE_CRC32 \
	-DLZMA_API_STATIC -DPUGIXML_NO_EXCEPTIONS -DSFML_STATIC -DSPNG_STATIC \
	-DCURL_STATICLIB \
	-DTINYGLTF_NOEXCEPTION -DTINYGLTF_NO_EXTERNAL_IMAGE -DTINYGLTF_USE_CPP14 \
	-D__STDC_CONSTANT_MACROS -D__STDC_LIMIT_MACROS \
	-I$(EXT_DIR)/picojson -I$(GEN_DIR)/Source/Core \
	-I$(SRC_DIR)/DolphinLibretro/Common -I$(SRC_DIR)/DolphinLibretro/VideoContexts \
	-I$(EXT_DIR)/libretro-common/include \
	-I$(EXT_DIR)/Vulkan-Headers/include -I$(EXT_DIR)/VulkanMemoryAllocator/include \
	-I$(EXT_DIR)/fmt/fmt/include \
	-I$(EXT_DIR)/mbedtls/include -I$(EXT_DIR)/minizip-ng/minizip-ng \
	$(ZLIB_INC) $(LZMA_INC) $(ZSTD_INC) $(ICONV_INC) \
	-I$(EXT_DIR)/SFML/SFML/include -I$(EXT_DIR)/bzip2/bzip2 -I$(EXT_DIR)/expr/include \
	-I$(EXT_DIR)/hidapi/hidapi-src/hidapi -I$(EXT_DIR)/pugixml/pugixml/src \
	$(MGBA_INC) \
	-I$(EXT_DIR)/libspng/libspng/spng -I$(EXT_DIR)/xxhash/xxHash \
	-I$(EXT_DIR)/tinygltf \
	-I$(EXT_DIR)/curl/curl/include -I$(EXT_DIR)/FatFs -I$(EXT_DIR)/LZO \
	-I$(EXT_DIR)/lz4/lz4/lib -I$(EXT_DIR)/Bochs_disasm \
	-I$(EXT_DIR)/cpp-ipc/cpp-ipc/include \
	-isystem $(EXT_DIR)/libusb/libusb/libusb -isystem $(EXT_DIR)/watcher/watcher/include \
	-Wall -Wtype-limits -Wsign-compare -Wignored-qualifiers -Wuninitialized -Wshadow \
	-Winit-self -Wmissing-declarations -Wimplicit-fallthrough -Werror=format -Wno-trigraphs
DOLPHIN_CXXFLAGS := -std=c++23
ifneq ($(OS_ANDROID),1)
   DOLPHIN_FLAGS += -DZSTD_MULTITHREAD
endif
ifeq ($(HAVE_CPPIPC),1)
   DOLPHIN_FLAGS += -DHAVE_CPPIPC
endif
ifeq ($(HAVE_HIDAPI),1)
   DOLPHIN_FLAGS += -DHAVE_HIDAPI=1
endif
ifeq ($(OS_WIN),1)
   DOLPHIN_FLAGS += -DNOMINMAX -DUNICODE -D_UNICODE -DWIN32_LEAN_AND_MEAN \
	-D_CRT_NONSTDC_NO_WARNINGS -D_CRT_SECURE_NO_DEPRECATE -D_CRT_SECURE_NO_WARNINGS \
	-D_SCL_SECURE_NO_WARNINGS -D_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING \
	-D_WINSOCK_DEPRECATED_NO_WARNINGS -DSTRSAFE_NO_DEPRECATE -DHID_API_NO_EXPORT_DEFINE \
	-I$(EXT_DIR)/wil/include -I$(EXT_DIR)/ed25519
endif
ifeq ($(OS_ANDROID),1)
   DOLPHIN_FLAGS += -DENABLE_VFS_FD -DCIFACE_USE_ANDROID \
	-I$(EXT_DIR)/libadrenotools/include -I$(EXT_DIR)/libadrenotools/lib/linkernsbypass
endif

# Per-file additions.
ifeq ($(OS_WIN),1)
   # watcher's Windows backend throws.
   FILE_FLAGS_$(abspath $(SRC_DIR)/Common/FilesystemWatcher.cpp) := -fexceptions
endif
ifeq ($(ARCH_X86_64),1)
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/slide_hash_avx2.c) := -mavx2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/chunkset_avx.c) := -mavx2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/compare256_avx2.c) := -mavx2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/adler32_avx2.c) := -mavx2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/adler32_avx512.c) := -mavx512f -mavx512dq -mavx512bw -mavx512vl -mtune=cascadelake
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/adler32_avx512_vnni.c) := -mavx512f -mavx512dq -mavx512bw -mavx512vl -mavx512vnni -mtune=cascadelake
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/chunkset_sse41.c) := -msse4.1
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/adler32_sse42.c) := -msse4.2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/insert_string_sse42.c) := -msse4.2
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/adler32_ssse3.c) := -mssse3
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/x86/crc32_fold_pclmulqdq.c) := -mssse3 -msse4.2 -mpclmul
else ifeq ($(ARCH_ARM64),1)
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/arm/adler32_neon.c) := -march=armv8-a+simd
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/arm/chunkset_neon.c) := -march=armv8-a+simd
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/arm/compare256_neon.c) := -march=armv8-a+simd
   FILE_FLAGS_$(abspath $(ZLIBNG_DIR)/arch/arm/slide_hash_neon.c) := -march=armv8-a+simd
   FILE_FLAGS_$(abspath $(SRC_DIR)/Common/Crypto/AES.cpp) := -march=armv8-a+crypto
   FILE_FLAGS_$(abspath $(SRC_DIR)/Common/Crypto/SHA1.cpp) := -march=armv8-a+crypto
endif

# Libraries in link order; the optional ones only where they are built.
LIB_GROUPS := DOLPHIN LIBRETRO_COMMON CURL MBEDTLS MINIZIP ZSTD ZLIB LZMA BZIP2 LZ4 LZO SPNG \
	MGBA SFML FMT PUGIXML XXHASH TINYGLTF FATFS
ifeq ($(ARCH_X86_64),1)
   LIB_GROUPS += BDISASM
endif
ifeq ($(HAVE_LIBUSB),1)
   LIB_GROUPS += LIBUSB
endif
ifeq ($(HAVE_HIDAPI),1)
   LIB_GROUPS += HIDAPI
endif
ifeq ($(HAVE_BUNDLED_ICONV),1)
   LIB_GROUPS += ICONV LIBCHARSET
endif
ifeq ($(HAVE_CPPIPC),1)
   LIB_GROUPS += CPPIPC
endif
ifeq ($(OS_ANDROID),1)
   ifeq ($(ARCH_ARM64),1)
      LIB_GROUPS += ADRENOTOOLS
   endif
endif
