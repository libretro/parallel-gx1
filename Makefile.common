	$(CORE_DIR)/Source/Core/VideoBackends/D3D12/DX12VertexFormat.cpp \
	$(CORE_DIR)/Source/Core/VideoBackends/D3D12/VideoBackend.cpp
endif
ifeq ($(ARCH_ARM64),1)
   DOLPHIN_SOURCES_CXX += \
	$(CORE_DIR)/Source/Core/Common/Arm64Emitter.cpp \
	$(CORE_DIR)/Source/Core/Common/ArmCPUDetect.cpp \
	$(CORE_DIR)/Source/Core/Common/ArmFPURoundMode.cpp \
	$(CORE_DIR)/Source/Core/VideoCommon/VertexLoaderARM64.cpp \
	$(CORE_DIR)/Source/Core/VideoCommon/TextureDecoder_Generic.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/Jit.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitAsm.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64Cache.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_BackPatch.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_Branch.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_FloatingPoint.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_Integer.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_LoadStore.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_LoadStoreFloating.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_LoadStorePaired.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_Paired.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_RegCache.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_SystemRegisters.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/Jit_Util.cpp \
	$(CORE_DIR)/Source/Core/Core/PowerPC/JitArm64/JitArm64_Tables.cpp
endif
ifeq ($(OS_ANDROID),1)
   DOLPHIN_SOURCES_CXX += \
	$(CORE_DIR)/Source/Core/Common/Logging/ConsoleListenerDroid.cpp \
	$(CORE_DIR)/Source/Core/Common/MemArenaAndroid.cpp
endif
ifeq ($(OS_APPLE),1)
   DOLPHIN_SOURCES_CXX += \
	$(CORE_DIR)/Source/Core/Common/MemArenaDarwin.cpp \
	$(CORE_DIR)/Source/Core/Core/HW/EXI/BBA/TAP_Apple.cpp
   DOLPHIN_SOURCES_OBJCXX += \
	$(CORE_DIR)/Source/Core/Common/CommonFuncsObjC.mm
endif
ifeq ($(OS_IOS),1)
   DOLPHIN_SOURCES_CXX += \
	$(CORE_DIR)/Source/Core/Common/JITMemoryTracker.cpp
endif

# On Android the libretro frontend provides the GC adapter interface
# (DolphinLibretro/Host.cpp).
ifeq ($(OS_ANDROID),1)
   DOLPHIN_SOURCES_CXX := $(filter-out $(SRC_DIR)/InputCommon/GCAdapter.cpp,$(DOLPHIN_SOURCES_CXX))
endif

# ----------------------------------------------------------------------------
# Per-library flags
# ----------------------------------------------------------------------------
# <LIB>_FLAGS applies to every object of that library, <LIB>_CFLAGS and
# <LIB>_CXXFLAGS to its C and C++ objects only. Third-party code builds
# with warnings off.


FATFS_FLAGS := -w -I$(EXT_DIR)/FatFs

# RSLC_EXTENDED: rslc takes the stages and types the core's shaders use.
# RSLC_BUILD: the generators build their stages by calls.
LIBRETRO_COMMON_FLAGS := -DHAVE_THREADS -DHAVE_THREAD_STORAGE -DRSLC_EXTENDED -DRSLC_BUILD \
	-I$(EXT_DIR)/libretro-common/include
ifneq ($(OS_WIN),1)
   LIBRETRO_COMMON_FLAGS += -DHAVE_MMAP
endif





FMT_FLAGS := -w -I$(EXT_DIR)/fmt/fmt/include

HIDAPI_FLAGS := -w -I$(EXT_DIR)/hidapi/hidapi-src/hidapi
ifeq ($(OS_UNIX),1)
   HIDAPI_FLAGS += -isystem $(EXT_DIR)/libusb/libusb/libusb
endif
# The core exports the libretro API only; hidapi would dllexport its own.
ifeq ($(OS_WIN),1)
   HIDAPI_FLAGS += -DHID_API_NO_EXPORT_DEFINE
endif

LIBUSB_FLAGS := -w -I$(EXT_DIR)/libusb/makefile -I$(EXT_DIR)/libusb/libusb/libusb

MGBA_FLAGS := -w -DBUILD_STATIC -DDISABLE_THREADING -DENABLE_DIRECTORIES -DENABLE_VFS \
	-DENABLE_VFS_FD -DHAVE_SETLOCALE -DHAVE_STRDUP -DHAVE_VASPRINTF \
	-DM_CORE_GB -DM_CORE_GBA -DUSE_LZMA -D_7ZIP_PPMD_SUPPPORT \
	$(MGBA_INC) -I$(EXT_DIR)/mGBA/mgba/src -I$(EXT_DIR)/mGBA/mgba/src/third-party/lzma \
	-fwrapv
MGBA_CFLAGS := -std=c11
ifneq ($(OS_WIN),1)
   MGBA_FLAGS += -DHAVE_FREELOCALE -DHAVE_FUTIMENS -DHAVE_LOCALE -DHAVE_LOCALTIME_R \
	-DHAVE_NEWLOCALE -DHAVE_PTHREAD_CREATE -DHAVE_PTHREAD_SETNAME_NP -DHAVE_REALPATH \
	-DHAVE_STRLCPY -DHAVE_STRNDUP -DHAVE_USELOCALE -DUSE_PTHREADS
endif
ifeq ($(OS_ANDROID),1)
   MGBA_FLAGS += -DHAVE_STRTOF_L -DHAVE_XLOCALE -Dfutimes=futimens
else
   MGBA_FLAGS += -D_GNU_SOURCE
endif
ifeq ($(OS_UNIX),1)
   MGBA_FLAGS += -DHAVE_FUTIMES -pthread
endif
ifeq ($(OS_APPLE),1)
   MGBA_FLAGS += -D_DARWIN_C_SOURCE -DHAVE_FUTIMES -DHAVE_XLOCALE -DHAVE_SNPRINTF_L -DHAVE_STRTOF_L
endif






# Dolphin itself: every Source/ unit shares one set.
DOLPHIN_FLAGS := \
	-DENABLE_DIRECTORIES -DHAVE_THREAD_STORAGE -DENABLE_VFS -DHAS_LIBMGBA \
	-D__STDC_CONSTANT_MACROS -D__STDC_LIMIT_MACROS \
	-I$(GEN_DIR)/Source/Core \
	-I$(SRC_DIR)/DolphinLibretro/Common -I$(SRC_DIR)/DolphinLibretro/VideoContexts \
	-I$(EXT_DIR)/libretro-common/include \
	-I$(EXT_DIR)/Vulkan-Headers/include \
	-I$(EXT_DIR)/fmt/fmt/include \
	-I$(EXT_DIR)/hidapi/hidapi-src/hidapi \
	$(MGBA_INC) \
	-I$(EXT_DIR)/FatFs \
	-isystem $(EXT_DIR)/libusb/libusb/libusb \
	-Wall -Wtype-limits -Wsign-compare -Wignored-qualifiers -Wuninitialized -Wshadow \
	-Winit-self -Wmissing-declarations -Wimplicit-fallthrough -Werror=format -Wno-trigraphs
DOLPHIN_CXXFLAGS := -std=c++23
ifeq ($(HAVE_HIDAPI),1)
   DOLPHIN_FLAGS += -DHAVE_HIDAPI=1
endif
ifeq ($(OS_WIN),1)
   DOLPHIN_FLAGS += -DNOMINMAX -DUNICODE -D_UNICODE -DWIN32_LEAN_AND_MEAN \
	-D_CRT_NONSTDC_NO_WARNINGS -D_CRT_SECURE_NO_DEPRECATE -D_CRT_SECURE_NO_WARNINGS \
	-D_SCL_SECURE_NO_WARNINGS -D_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING \
	-D_WINSOCK_DEPRECATED_NO_WARNINGS -DSTRSAFE_NO_DEPRECATE -DHID_API_NO_EXPORT_DEFINE
endif
ifeq ($(OS_ANDROID),1)
   DOLPHIN_FLAGS += -DENABLE_VFS_FD
endif

# Per-file additions.
ifeq ($(ARCH_X86_64),1)
else ifeq ($(ARCH_ARM64),1)
   FILE_FLAGS_$(abspath $(SRC_DIR)/Common/Crypto/AES.cpp) := -march=armv8-a+crypto
   FILE_FLAGS_$(abspath $(SRC_DIR)/Common/Crypto/SHA1.cpp) := -march=armv8-a+crypto
endif

# libretro-common's archive code: zip (stored, deflate, deflate64, Zstandard) and Zstandard
# archives, through its own decoders. Only these files: elsewhere HAVE_COMPRESSION asks for
# streams this core does not build.
LRC_ARCHIVE_FLAGS := -DHAVE_COMPRESSION -DHAVE_RZSTD
FILE_FLAGS_$(abspath $(EXT_DIR)/libretro-common/file/archive_file.c) := $(LRC_ARCHIVE_FLAGS)
FILE_FLAGS_$(abspath $(EXT_DIR)/libretro-common/file/archive_file_zlib.c) := $(LRC_ARCHIVE_FLAGS)
FILE_FLAGS_$(abspath $(EXT_DIR)/libretro-common/file/archive_file_zstd.c) := $(LRC_ARCHIVE_FLAGS)

# WIA and RVZ images, Zstandard groups included.
FILE_FLAGS_$(abspath $(EXT_DIR)/libretro-common/formats/rvz/rvz.c) := -DHAVE_RZSTD

# Libraries in link order; the optional ones only where they are built.
LIB_GROUPS := DOLPHIN LIBRETRO_COMMON \
	MGBA FMT FATFS
ifeq ($(HAVE_LIBUSB),1)
   LIB_GROUPS += LIBUSB
endif
ifeq ($(HAVE_HIDAPI),1)
   LIB_GROUPS += HIDAPI
endif
